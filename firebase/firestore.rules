rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    // Default deny: no unauthenticated access, no public portfolio collections.
    match /{document=**} {
      allow read, write: if false;
    }
    match /users/{uid}/portfolio/{docId} {
      allow read: if request.auth != null && request.auth.uid == uid;
      allow create, update: if request.auth != null
        && request.auth.uid == uid
        && docId == "current"
        && request.resource.data.keys().hasOnly(["payload", "schemaVersion", "updatedAt"])
        && request.resource.data.schemaVersion is int
        && request.resource.data.schemaVersion >= 1
        && request.resource.data.payload is map
        && request.resource.data.payload.keys().hasAll(["properties", "loans", "assets"])
        && request.resource.data.payload.properties is list
        && request.resource.data.payload.loans is list
        && request.resource.data.payload.assets is list;
      allow delete: if request.auth != null && request.auth.uid == uid;
    }
  }
}
