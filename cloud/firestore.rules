rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    function accountAvailable(uid) {
      return !exists(/databases/$(database)/documents/accountDeletions/$(uid));
    }
    // Deny everything by default. Only authenticated owners can read/write
    // their own account-scoped documents. Never use public test-mode rules.
    match /users/{userId} {
      allow read: if request.auth != null && request.auth.uid == userId && accountAvailable(userId);
      allow create, update: if request.auth != null && request.auth.uid == userId && accountAvailable(userId)
        && request.resource.data.keys().hasOnly(['createdAt','updatedAt','displayName'])
        && request.resource.data.displayName is string
        && request.resource.data.displayName.size() <= 120;
    }
    // Access is provisioned by Admin SDK / verified billing only. An APK, backup,
    // profile field or email cannot grant owner or subscription status.
    match /accountAccess/{userId} {
      allow read: if request.auth != null && request.auth.uid == userId && accountAvailable(userId) && multiAccess(userId);
      allow write: if false;
    }
    // One explicit server-timestamp activation per account; no reset, extension
    // or imported client date. This never grants multi-property access.
    match /rentalTrials/{userId} {
      allow read: if request.auth != null && request.auth.uid == userId && accountAvailable(userId);
      allow create: if request.auth != null && request.auth.uid == userId && accountAvailable(userId)
        && request.resource.data.keys().hasOnly(['startedAt'])
        && request.resource.data.startedAt == request.time;
      allow update, delete: if false;
      match /access/{probeId} {
        allow read: if request.auth != null && request.auth.uid == userId && accountAvailable(userId)
          && probeId == 'current' && trialActive(userId);
        allow write: if false;
      }
    }
    function trialActive(uid) {
      let path = /databases/$(database)/documents/rentalTrials/$(uid);
      return exists(path) && get(path).data.startedAt is timestamp
        && get(path).data.startedAt <= request.time
        && (request.time - get(path).data.startedAt) < duration.value(90, 'd');
    }
    function multiAccess(uid) {
      let path = /databases/$(database)/documents/accountAccess/$(uid);
      return exists(path) && (get(path).data.get('owner', false) == true ||
        (get(path).data.get('status', '') == 'active' &&
         get(path).data.get('expiresAt', request.time) is timestamp &&
         get(path).data.get('expiresAt', request.time) > request.time));
    }
    match /users/{userId}/portfolios/{portfolioId} {
      allow read: if request.auth != null && request.auth.uid == userId && accountAvailable(userId);
      function validWrite() {
        return request.auth != null && request.auth.uid == userId && accountAvailable(userId)
        && portfolioId == 'current'
        && request.resource.data.keys().hasOnly(['schemaVersion','revision','updatedAt','payload'])
        && request.resource.data.schemaVersion is int
        && request.resource.data.schemaVersion == 1
        && request.resource.data.revision is int
        && request.resource.data.revision >= 1
        && request.resource.data.updatedAt == request.time
        && request.resource.data.payload is map
        && request.resource.data.payload.keys().hasAll(['settings','properties','loans','assets'])
        && request.resource.data.payload.properties is list
        && request.resource.data.payload.loans is list
        && request.resource.data.payload.assets is list
        && request.resource.data.payload.settings is map
        && (request.resource.data.payload.properties.size() <= 1 || multiAccess(userId));
      }
      allow create: if validWrite() && request.resource.data.revision == 1;
      allow update: if validWrite() && resource.data.revision is int
        && request.resource.data.revision == resource.data.revision + 1;
      // Cloud data removal will be performed by a verified account-deletion flow.
      // A compromised WebView must not be able to delete the only remote backup.
      allow delete: if false;
    }
  }
}
